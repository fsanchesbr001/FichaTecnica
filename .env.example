# -----------------------------
# App profile
# -----------------------------
APP_PROFILE=development
TIMEZONE=America/Sao_Paulo

# -----------------------------
# Portas publicas no host
# -----------------------------
APP_EXTERNAL_PORT=8080
DB_EXTERNAL_PORT=3306
PROMETHEUS_EXTERNAL_PORT=9090
GRAFANA_EXTERNAL_PORT=3000

# -----------------------------
# Banco MySQL
# -----------------------------
MYSQL_DATABASE=FichaTecnica
MYSQL_USER=ficha_app
MYSQL_PASSWORD=troque-esta-senha
MYSQL_ROOT_PASSWORD=troque-esta-senha-root

# -----------------------------
# JWT e seguranca
# -----------------------------
JWT_SECRET=troque-para-um-segredo-forte
JWT_EXPIRATION_MINUTES=120

# -----------------------------
# Frontend autorizado (CORS)
# -----------------------------
SITE_ORIGIN_ALLOWED=http://localhost:4200

# -----------------------------
# E-mail e outbox (gere a chave conforme README)
# -----------------------------
MAIL_HOST=smtp.zoho.com
MAIL_PORT=465
MAIL_USER=
MAIL_PWD=
MAIL_PROVIDER=smtp
MAIL_FROM=contato@fabriciosanches.com
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=
ZOHO_ACCOUNT_ID=
OUTBOX_ENCRYPTION_KEY=
MAIL_OUTBOX_WORKER_ENABLED=true
SYSTEM_USER=
SYSTEM_PWD=

# -----------------------------
# Observabilidade
# -----------------------------
GRAFANA_ADMIN_PASSWORD=admin
